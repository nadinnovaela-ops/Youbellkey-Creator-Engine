# === Control Plane (Vercel + Supabase) ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Master encryption key (32-byte hex) for encrypting user BYOK API keys & OAuth refresh tokens at rest
YB_SECRETS_MASTER_KEY=replace-with-64-hex-chars

# === Object Storage (Cloudflare R2 — S3 Compatible) ===
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=youbellkey-media
R2_PUBLIC_BASE_URL=

# === Universal Worker Connection ===
YB_CONTROL_PLANE_URL=http://localhost:3000
YB_WORKER_TOKEN=replace-with-worker-registration-token
YB_WORKER_ID=local-pc-01

# === Free-Tier AI / TTS / Alignment Providers (BYOK) ===
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_CLOUD_TTS_API_KEY=

# === YouTube Data API v3 (OAuth2 + Research) ===
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
